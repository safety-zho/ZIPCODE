# 이 파일을 .env 로 복사한 뒤 값을 바꾸세요.

# 조회 방식
#   web : 인터넷우체국 우편번호 검색 화면의 결과를 읽음 (인증키 불필요)
#   api : 우정사업본부 공식 OpenAPI 사용 (공공데이터포털 인증키 필요, 정식 운영 권장)
EPOST_MODE=web

# api 방식일 때 공공데이터포털 인증키 (일반 인증키 Decoding/Encoding 둘 다 가능)
# https://www.data.go.kr/data/15000124/openapi.do
EPOST_SERVICE_KEY=

# 우체국 서버 요청 간격(초). 너무 짧게 하면 차단될 수 있습니다.
EPOST_MIN_INTERVAL=0.3

# 접속 주소. 이 PC에서만 쓰면 127.0.0.1, 같은 망의 다른 PC에서도 쓰려면 0.0.0.0
HOST=127.0.0.1
PORT=8000

# 한 번에 처리할 최대 주소 수, 업로드 최대 크기(MB)
MAX_ROWS=5000
MAX_UPLOAD_MB=20

# 서버를 다시 켜도 조회 결과 서명이 유지되게 하려면 임의의 긴 문자열을 넣으세요.
# 비워 두면 실행할 때마다 새로 만들어집니다(재시작 후에는 다시 조회해야 함).
APP_SECRET=

# 실행 시 브라우저 자동 열기 (1/0)
OPEN_BROWSER=1

# 인터넷우체국 응답을 해석하지 못했을 때 원문을 저장할 폴더 (문제 확인용, 평소엔 비워 둠)
EPOST_DEBUG_DIR=

# 인터넷우체국 검색 주소 (화면 구조가 바뀌어 주소를 바꿔야 할 때만 수정)
# EPOST_WEB_URL=https://www.epost.kr/search.RetrieveIntegrationNewZipCdList.comm
